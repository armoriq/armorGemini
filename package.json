{
  "name": "armorgemini",
  "version": "0.3.2",
  "description": "ArmorIQ intent-based security enforcement for the Gemini CLI. Enforces that Gemini declares what it intends to do before doing it, and every action is checked against that declared intent.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "hook:before-tool": "node scripts/hook-router.mjs before-tool",
    "hook:after-tool": "node scripts/hook-router.mjs after-tool",
    "hook:session-start": "node scripts/hook-router.mjs session-start",
    "hook:session-end": "node scripts/hook-router.mjs session-end",
    "hook:before-agent": "node scripts/hook-router.mjs before-agent",
    "hook:before-tool-selection": "node scripts/hook-router.mjs before-tool-selection",
    "mcp": "node scripts/policy-mcp.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "keywords": [
    "gemini-cli",
    "gemini-cli-extension",
    "security",
    "policy",
    "audit",
    "intent",
    "armoriq"
  ],
  "author": {
    "name": "ArmorIQ",
    "email": "license@armoriq.io"
  },
  "license": "MIT"
}
